<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
            android:shortcutId="freeze_all"
            android:icon="@drawable/ic_round_frozen_shortcut"
            android:shortcutShortLabel="@string/action_freeze_all">
        <intent
                android:action="com.aistra.hail.action.FREEZE_ALL"/>
    </shortcut>
    <shortcut
            android:shortcutId="unfreeze_all"
            android:icon="@drawable/ic_round_unfrozen_shortcut"
            android:shortcutShortLabel="@string/action_unfreeze_all">
        <intent
                android:action="com.aistra.hail.action.UNFREEZE_ALL"/>
    </shortcut>
    <shortcut
            android:shortcutId="freeze_non_whitelisted"
            android:icon="@drawable/ic_round_frozen_shortcut"
            android:shortcutShortLabel="@string/action_freeze_non_whitelisted">
        <intent
                android:action="com.aistra.hail.action.FREEZE_NON_WHITELISTED"/>
    </shortcut>
    <shortcut
            android:shortcutId="freeze_auto"
            android:icon="@drawable/ic_round_frozen_shortcut"
            android:shortcutShortLabel="@string/auto_freeze">
        <intent
                android:action="com.aistra.hail.action.FREEZE_AUTO"/>
    </shortcut>
    <shortcut
            android:shortcutId="lock"
            android:icon="@drawable/ic_outline_lock_shortcut"
            android:shortcutShortLabel="@string/action_lock">
        <intent
                android:action="com.aistra.hail.action.LOCK"/>
    </shortcut>
    <shortcut
            android:shortcutId="lock_freeze"
            android:icon="@drawable/ic_outline_lock_shortcut"
            android:shortcutShortLabel="@string/action_lock_freeze">
        <intent
                android:action="com.aistra.hail.action.LOCK_FREEZE"/>
    </shortcut>
</shortcuts>
